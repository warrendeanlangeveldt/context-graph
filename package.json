    "test:watch": "vitest",
    "ctx": "node dist/cli/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "picomatch": "^4.0.2",
    "ws": "^8.21.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/picomatch": "^3.0.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
