{
  "name": "context-graph",
  "version": "0.1.0",
  "description": "Per-edit context slices, decision recording, and context observation for any repository and any AI coding harness",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "ctx": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
