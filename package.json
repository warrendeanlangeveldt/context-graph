{
  "name": "@warren-dean/context-graph",
  "version": "0.2.11",
  "description": "Gives AI coding agents the why behind your code, and makes them keep it: file cards, rules and decisions kept in git and delivered before every edit, for Claude Code and Codex",
  "license": "MIT",
  "author": "Warren Langeveldt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warrendeanlangeveldt/context-graph.git"
  },
  "homepage": "https://github.com/warrendeanlangeveldt/context-graph#readme",
  "bugs": "https://github.com/warrendeanlangeveldt/context-graph/issues",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "codex",
    "ai-agents",
    "context",
    "architecture-decision-records",
    "mcp"
  ],
  "type": "module",
  "contextGraph": true,
  "bin": {
    "ctx": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "adapters",
    "packs",
    "view/dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "docs/design-spec.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "gen:packs": "node scripts/gen-packs.mjs",
    "gen:packs:check": "node scripts/gen-packs.mjs --check",
    "build": "npm run gen:packs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle": "node scripts/bundle.mjs",
    "bundle:check": "node scripts/bundle.mjs --check",
    "view:build": "cd view && npm install --no-audit --no-fund && npm run build",
    "prepack": "npm run build && npm run bundle && npm run view:build",
    "ctx": "node dist/cli/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "picomatch": "^4.0.2",
    "ws": "^8.21.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@types/node": "^22.15.0",
    "@types/picomatch": "^3.0.2",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  }
}
